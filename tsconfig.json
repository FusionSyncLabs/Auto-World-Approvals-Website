{
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/routes",
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "src/start.ts",
    "src/server.ts",
    "src/entry-client.tsx",
    "src/entry-server.tsx",
    "src/lib/**/*.functions.ts",
    "src/lib/*.functions.ts",
    "src/lib/**/*.server.ts",
    "src/lib/*.server.ts",
    "src/components/crm",
    "src/components/admin"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "Bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true
  }
}
